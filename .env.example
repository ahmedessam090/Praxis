# Copy to .env — no real keys are required for the pre-phase durability proof.

# ---- Temporal ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ta-default

# ---- Domain DB (SQLite) ----
DB_PATH=./data/ta.db

# ---- Data providers (Phase 1; optional now) ----
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
FRED_API_KEY=

# ---- LLM (OpenAI vision validator/narrator) ----
# Either OPENAI_API_KEY or OPENAI_KEY is accepted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini
# LLM_ENABLED=true means: validate/narrate with OpenAI when a key is present.
# Set to false to run the deterministic engine alone (no key needed).
LLM_ENABLED=true
ANTHROPIC_API_KEY=

# ---- Misc ----
LOG_LEVEL=INFO
